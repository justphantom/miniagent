# miniagent deployment variables — the committed default. Copy to deploy/.env (git-ignored)
# and edit to override per-host. Sourced by deploy.sh and envsubst into miniagent.service.
MINIAGENT_WORKDIR=/var/lib/miniagent
MINIAGENT_CONFIG=/etc/miniagent/miniagent.json
MINIAGENT_USER=miniagent
MINIAGENT_GROUP=miniagent