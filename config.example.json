// miniagent 配置示例
// 说明：JSON 标准不支持注释，复制到正式文件前请删除本文件中的所有 // 注释行。
// 所有 duration 字段均为字符串，如 "30s"、"5m"、"2h"。
// 本配置不支持 ${VAR} 环境变量注入；所有值均按字面量读取。
{
  // providers：至少配置一个；name 不得含 '/'。
  "providers": [
    {
      "name": "openai",
      // chat_url：完整的 OpenAI 兼容 chat completions 端点。
      "chat_url": "https://api.openai.com/v1/chat/completions",
      // models_url：可选；配置后 -list-models 会发 GET 请求，否则用静态 models 列表。
      "models_url": "https://api.openai.com/v1/models",
      // key：API 密钥，按字面量读取；明文入文件，注意权限（建议 0600）。
      // 也可留空改用 $MINIAGENT_API_KEY 环境变量注入。
      "key": "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      // models：静态模型列表；models_url 为空时 -list-models 直接返回该列表。
      "models": ["gpt-4o", "gpt-4o-mini", "o3-mini"]
      // openai 系的默认思考字段即 reasoning_effort（wire.go 自动注入），无需在此声明 thinking
      // 映射；显式写 field:"reasoning_effort" 反会被 validateConfig 当作误配拒绝。若需跨供应商
      // 字段映射（如 anthropic 用 thinking 字段），参考下方第二个 provider 的写法。
    },
    {
      // 第二个 provider 示例：Anthropic 兼容代理。
      "name": "anthropic",
      "chat_url": "https://api.anthropic.com/v1/messages",
      "models_url": "https://api.anthropic.com/v1/models",
      "key": "sk-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy",
      "models": ["claude-sonnet-4", "claude-opus-4"],
      "thinking": {
        "field": "thinking",
        "map": {
          "off": "off",
          "low": "low",
          "medium": "medium",
          "high": "high",
          "max": "high"
        }
      }
    }
  ],

  // session：会话持久化配置。
  "session": {
    // dir：session jsonl 文件存放目录；session id 会解析为该目录下的 .jsonl。
    "dir": ".sessions"
  },

  // defaults：默认策略参数。
  "defaults": {
    // model：格式为 provider/id；多 provider 时必须带 provider/ 前缀。
    "model": "openai/gpt-4o",
    // thinking：思考级别 off|minimal|low|medium|high|xhigh|max。
    "thinking": "off",
    // mode：权限模式 default|auto。default 模式要求 run.workdir 非空。
    "mode": "default",
    // system_prompt：自定义系统提示词；空则使用内置代码向 prompt。
    "system_prompt": "",
    // summary_request：撞 max_iterations 上限时注入的总结请求文案。
    "summary_request": "请总结已完成的工具和关键结果，不要继续调用工具。",
    // summarizer_prompt：摘要压缩时使用的 system prompt。
    "summarizer_prompt": "你是上下文压缩助手，请用精简中文总结对话中段内容。"
  },

  // run：运行参数与限额；所有字段均为可选，<=0 或缺省时使用内置默认值。
  "run": {
    // workdir：default 模式下写工具边界与 shell 的 cwd；.miniagent/ 规则发现根。
    "workdir": "./repo",
    // max_tokens：单次 LLM 调用最大输出 token 数。
    "max_tokens": 4096,
    // max_iterations：单轮 ReAct 循环最大 LLM 调用次数。
    "max_iterations": 20,
    // max_tokens_total：单轮累计 input+output token 上限，超限报错退出；0=不限。
    "max_tokens_total": 0,
    // context_window：模型 context 上限；>0 时主动裁剪历史。
    "context_window": 128000,
    // max_duration：整轮最大运行时长；0=不限。
    "max_duration": "5m",
    // shell_timeout：shell/script 工具命令超时。
    "shell_timeout": "30s",
    // file_op_timeout：read/grep/glob/edit 等文件操作超时。
    "file_op_timeout": "20s",
    // write_timeout：write 工具超时。
    "write_timeout": "10s",
    // http_timeout：非流式 LLM HTTP 调用总超时；流式不受此限制。
    "http_timeout": "180s",
    // stream：true 启用 SSE 流式输出。
    "stream": false,
    // max_tool_result_chars：工具结果入历史默认字符上限。
    "max_tool_result_chars": 2000,
    // max_file_result_chars：read/edit 等代码类工具结果入历史字符上限。
    "max_file_result_chars": 8000,
    // max_parallel_tools：同一步并行工具上限。
    "max_parallel_tools": 8,
    // context_keep_recent：上下文压缩时保留的最近轮数。
    "context_keep_recent": 6,
    // summary_max_chars：摘要压缩输出字符上限。
    "summary_max_chars": 2000,
    // summary_max_tokens：摘要 LLM 调用 max_tokens。
    "summary_max_tokens": 512,
    // max_read_file_bytes：read 单文件读取字节上限。
    "max_read_file_bytes": 524288,
    // max_shell_output_chars：shell 输出字符上限。
    "max_shell_output_chars": 100000,
    // max_session_bytes：session 文件单文件大小上限。
    "max_session_bytes": 10485760,
    // grep_max_matches：grep 命中行上限。
    "grep_max_matches": 500,
    // memory_recent_n：注入 system prompt 的最近记忆条数。
    "memory_recent_n": 10,
    // context_trim_tool_chars：context 超限时 tool content 二次裁剪字符数。
    "context_trim_tool_chars": 1000
  },

  // compaction：长会话摘要压缩配置。
  "compaction": {
    // model：摘要压缩使用的模型 id。可写 model id（同主模型 provider），
    // 或 provider/model（跨 provider）。
    "model": "gpt-4o-mini"
  }
}
