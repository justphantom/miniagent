{
  "providers": [
    {
      "name": "openai",
      "chat_url": "https://api.openai.com/v1/chat/completions",
      "models_url": "https://api.openai.com/v1/models",
      "key": "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "models": [
        {"name": "gpt-4o"},
        {"name": "gpt-4o-mini"},
        {"name": "o3-mini", "max_tokens": 8192, "context_window": 200000, "thinking": "medium"}
      ],
      "thinking": {
        "field": "reasoning_effort",
        "map": {
          "off": "off",
          "minimal": "minimal",
          "low": "low",
          "medium": "medium",
          "high": "high",
          "xhigh": "xhigh",
          "max": "max"
        }
      }
    },
    {
      "name": "anthropic",
      "chat_url": "https://api.anthropic.com/v1/messages",
      "models_url": "https://api.anthropic.com/v1/models",
      "key": "sk-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy",
      "models": [{"name":"claude-sonnet-4"},{"name":"claude-opus-4"}],
      "headers": {
        "anthropic-version": "2023-06-01",
        "X-Tenant-Id": "my-tenant"
      },
      "thinking": {
        "field": "thinking",
        "map": {
          "off": "off",
          "low": "low",
          "medium": "medium",
          "high": "high",
          "max": "high"
        }
      }
    }
  ],
  "session": {
    "dir": ".sessions"
  },
  "defaults": {
    "provider": "openai",
    "model": "gpt-4o",
    "thinking": "off",
    "mode": "default",
    "system_prompt": "",
    "summary_request": "Summarize the completed tools and key results; do not continue calling tools.",
    "summarizer_prompt": "You are a context compression assistant; summarize the middle section of the conversation concisely in Chinese."
    // The following prompt templates are optional (empty uses the built-in default); placeholders: subagent_guidance={config_path}/{mode},
    // summary_create/update_instruction={max_chars}, summary_template has no placeholder.
    // "subagent_guidance": "- Subtask delegation: miniagent -config {config_path} -mode {mode} ...",
    // "summary_create_instruction": "You are a session compressor. Compress into a summary of no more than {max_chars} characters.",
    // "summary_update_instruction": "Update the existing summary, output no more than {max_chars} characters.",
    // "summary_template": "## Goal\n## Key details\n..."
  },
  "run": {
    "workdir": "./repo",
    "max_tokens": 4096,
    "max_iterations": 20,
    "max_tokens_total": 0,
    "context_window": 128000,
    "max_duration": "5m",
    "shell_timeout": "30s",
    "file_op_timeout": "20s",
    "write_timeout": "10s",
    "http_timeout": "180s",
    "stream": false,
    "confirm_destructive": false,
    "max_tool_result_chars": 2000,
    "max_file_result_chars": 8000,
    "max_parallel_tools": 8,
    "context_keep_recent": 6,
    "context_keep_reasoning": 1,
    "context_keep_tool_args": 2,
    "context_keep_reasoning_chars": 4000,
    "summary_max_chars": 2000,
    "summary_max_tokens": 512,
    "max_read_file_bytes": 524288,
    "max_shell_output_chars": 100000,
    "max_session_bytes": 10485760,
    "grep_max_matches": 500,
    "context_trim_tool_chars": 1000,
    "context_use_real_usage": true,
    "shell_stream_window_bytes": 0,
    "preserve_recent_tokens": 0,
    "tool_output_dir": "",
    "tool_output_retention": "168h"
  },
  "compaction": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "auto": true,
    "reserved": 0
  }
}
