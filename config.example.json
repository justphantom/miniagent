{
  "providers": [
    {
      "name": "openai",
      "chat_url": "https://api.openai.com/v1/chat/completions",
      "models_url": "https://api.openai.com/v1/models",
      "key": "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "models": [
        {"name": "gpt-4o"},
        {"name": "gpt-4o-mini"},
        {"name": "o3-mini", "max_tokens": 8192, "context_window": 200000, "thinking": "medium"}
      ],
      "thinking": {
        "field": "reasoning_effort",
        "map": {
          "off": "off",
          "minimal": "minimal",
          "low": "low",
          "medium": "medium",
          "high": "high",
          "xhigh": "xhigh",
          "max": "max"
        }
      },
      "stream_allow_unterminated": false
    },
    {
      "name": "openai-responses",
      "kind": "responses",
      "chat_url": "https://api.openai.com/v1/responses",
      "models_url": "https://api.openai.com/v1/models",
      "key": "sk-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz",
      "models": [
        {"name": "gpt-5.5", "max_tokens": 8192, "context_window": 200000}
      ],
      "thinking": {
        "field": "reasoning",
        "map": {
          "off": "off",
          "minimal": "minimal",
          "low": "low",
          "medium": "medium",
          "high": "high",
          "xhigh": "xhigh",
          "max": "max"
        }
      }
    },
    {
      "name": "anthropic",
      "kind": "anthropic",
      "chat_url": "https://api.anthropic.com/v1/messages",
      "models_url": "https://api.anthropic.com/v1/models",
      "key": "sk-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy",
      "max_tokens": 64000,
      "models": [
        {"name": "claude-sonnet-5", "context_window": 200000},
        {"name": "claude-opus-4-8", "context_window": 200000}
      ],
      "headers": {
        "X-Tenant-Id": "my-tenant"
      },
      "cache": true,
      "thinking": {
        "field": "thinking",
        "map": {
          "low": "{\"type\":\"adaptive\",\"effort\":\"low\"}",
          "medium": "{\"type\":\"adaptive\",\"effort\":\"medium\"}",
          "high": "{\"type\":\"adaptive\",\"effort\":\"high\"}"
        }
      }
    }
  ],
  "session": {
    "dir": ".sessions"
  },
  "defaults": {
    "provider": "openai",
    "model": "gpt-4o",
    "thinking": "off",
    "mode": "default",
    "system_prompt": "",
    "rules_file": "",
    "summary_request": "Summarize the completed tools and key results; do not continue calling tools.",
    "summarizer_prompt": "You are a context compression assistant; summarize the middle section of the conversation concisely in Chinese."
  },
  "run": {
    "max_tokens": 4096,
    "max_iterations": 20,
    "max_tokens_total": 0,
    "context_window": 128000,
    "max_duration": "5m",
    "shell_timeout": "30s",
    "file_op_timeout": "20s",
    "write_timeout": "10s",
    "http_timeout": "180s",
    "stream": false,
    "confirm_destructive": false,
    "max_tool_result_chars": 2000,
    "max_file_result_chars": 8000,
    "max_parallel_tools": 8,
    "context_keep_recent": 6,
    "context_keep_reasoning": 1,
    "context_keep_tool_args": 2,
    "context_keep_reasoning_chars": 4000,
    "summary_max_chars": 2000,
    "summary_max_tokens": 512,
    "max_read_file_bytes": 524288,
    "max_shell_output_chars": 100000,
    "max_session_bytes": 10485760,
    "grep_max_matches": 500,
    "context_trim_tool_chars": 1000,
    "context_use_real_usage": true,
    "shell_stream_window_bytes": 0,
    "preserve_recent_tokens": 0,
    "tool_output_dir": "",
    "tool_output_retention": "168h",
    "confine_eval_symlinks": false,
    "confine_auto": false,
    "web_timeout": "30s"
  },
  "compaction": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "auto": true,
    "reserved": 0
  }
}
